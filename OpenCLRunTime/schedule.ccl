# Schedule definition for thorn OpenCLRunTime

SCHEDULE OpenCLRunTime_Setup AT startup
{
  LANG: C
} "Set up OpenCL device"

# Ensure this routine is called late
SCHEDULE OpenCLRunTime_CopyBack AT analysis
{
  LANG: C
} "Copy OpenCL memory buffers back to host memory"

SCHEDULE OpenCLRunTime_Statistics AT terminate
{
  LANG: C
  OPTIONS: global
} "Output profiling information"
