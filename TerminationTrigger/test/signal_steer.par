ActiveThorns = "IOUtil IOBasic LocalReduce TerminationTrigger Trigger Pugh PUGHSlab"

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 2

IO::out_dir       = $parfile
IO::out_fileinfo = "none"
IO::parfile_write = "no"

IOBasic::outScalar_every = 1
IOBasic::outScalar_reductions = "min max"
IOBasic::outScalar_vars = "terminationtrigger::triggered"

TerminationTrigger::testsuite = "yes"

# Listen to no signal at startup, and steer signal_names[0] and
# signal_numbers[1] at iteration 0, as thorn HTTPD would. At iteration 1,
# the testsuite raises the signal of slot 0.
Trigger::Trigger_Number = 2

Trigger::Trigger_Checked_Variable[0]        = "Trigger::trigger_cctk_iteration"
Trigger::Trigger_Relation[0]                = ">"
Trigger::Trigger_Checked_Value[0]           = -1
Trigger::Trigger_Reaction[0]                = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn[0] = "TerminationTrigger"
Trigger::Trigger_Steered_Parameter_Name[0]  = "signal_names[0]"
Trigger::Trigger_Steered_Parameter_Value[0] = "SIGUSR1"
Trigger::Trigger_Once[0]                    = 1

Trigger::Trigger_Checked_Variable[1]        = "Trigger::trigger_cctk_iteration"
Trigger::Trigger_Relation[1]                = ">"
Trigger::Trigger_Checked_Value[1]           = -1
Trigger::Trigger_Reaction[1]                = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn[1] = "TerminationTrigger"
Trigger::Trigger_Steered_Parameter_Name[1]  = "signal_numbers[1]"
Trigger::Trigger_Steered_Parameter_Value[1] = "1"
Trigger::Trigger_Once[1]                    = 1
