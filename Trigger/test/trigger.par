!DESC "1+log sliced black hole, BSSN_MoL, Iterative CN"

# Required thorns

ActiveThorns = "time MoL pugh pughreduce pughslab boundary cartgrid3d bssn_mol idanalyticbh ioascii ioutil iobasic localreduce admcoupling admbase admmacros coordgauge spacemask staticconformal nanchecker coordbase symbase trigger"

# Grid

driver::global_nx = 20
driver::global_ny = 20
driver::global_nz = 20

grid::type   = "byspacing"
grid::dxyz   = 0.2
grid::domain = "octant"

cactus::cctk_initial_time = 0.0
cactus::cctk_itlast       = 10
 
time::dtfac = 0.25

# Initial data 

admbase::metric_type = "static conformal"
admbase::initial_data = "schwarzschild"

# Evolution

admbase::evolution_method = "adm_bssn" 

methodoflines::ode_method = "icn"

adm_bssn::bound  = "flat"

# Gauge

admbase::lapse_evolution_method = "1+log"

# Output

IO::out_fileinfo="none"
IO::out_dir = "trigger"

IOBasic::outInfo_every = 1
IOBasic::outInfo_vars  = "admbase::gxx"

IOBasic::outScalar_every =  2      
IOBasic::outScalar_vars  = "adm_bssn::adm_bs_gxx adm_bssn::adm_bs_Axx adm_bssn::adm_bs_phi adm_bssn::adm_bs_k adm_bssn::adm_bs_Gx admbase::gxx admbase::kxx admbase::alp"

trigger::Trigger_Number              = 1
trigger::Trigger_Checked_Variable[0] = "adm_bssn::adm_bs_Axx"
trigger::Trigger_Relation[0]         = ">"
trigger::Trigger_Checked_Value[0]    = 0.005
trigger::Trigger_Reduction[0]        = "maximum"
trigger::Trigger_Output_Method[0]    = "Scalar"
trigger::Trigger_Output_Variables[0] = "adm_bssn::adm_bs_Axx adm_bssn::adm_bs_gyy"
trigger::Trigger_Debug               = 1

##################################################################


# do not use the new scheme for names of output files
IO::new_filename_scheme = "no"
