# Parameter definitions for thorn Nice

CCTK_INT Trigger_Number "Number of triggers"
{
  0:10 :: "The number of triggers that are defined"
} 0

STRING Trigger_Checked_Variable[10] "variable to be checked for"
{
  ".+" :: "fully qualified variable name, 'param' for a parameter"
  "^$" :: "An empty string to trigger nothing"
} ""

STRING Trigger_Checked_Parameter_Thorn[10] "thorn of parameter to be checked for"
{
  ".+" :: "thorn name"
  "^$" :: "An empty string to trigger nothing"
} ""

STRING Trigger_Checked_Parameter_Name[10] "parameter name to be checked for"
{
  ".+" :: "parameter name"
  "^$" :: "An empty string to trigger nothing"
} ""

STRING Trigger_Relation[10] "relation operator for checked variable"
{
  ".+" :: "some relations"
} ">"

CCTK_REAL Trigger_Checked_Value[10] "triggered value for checked variable"
{
  :: "value to be triggered for"
} 1.0

STRING Trigger_Reduction[10] "valid reduction method"
{
  ".+" :: "some relations e.g. 'norm2'"
  "^$" :: "An empty string for no reduction (for scalars)"
} "norm2"

STRING Trigger_Reaction[10] "how to react on a positive trigger"
{
  ".+" :: "'output' for file output, 'steer' to steer a parameter"
} "output"

STRING Trigger_Output_Method[10] "IO-output method for this trigger"
{
  ".+" :: "an enabled IO-method"
  "^$" :: "An empty string for no output"
} "1D"

STRING Trigger_Output_Variables[10] "variable to be put out 'param' for parameter"
{
  ".+" :: "Space-separated list of fully qualified variable name"
  "^$" :: "An empty string to trigger nothing"     
} ""

STRING Trigger_Steered_Parameter_Thorn[10] "thorn of parameter to be changed"
{
  ".+" :: "thorn name"
  "^$" :: "An empty string to change nothing"
} ""

STRING Trigger_Steered_Parameter_Name[10] "parameter name to be changed"
{
  ".+" :: "parameter name"
  "^$" :: "An empty string to change nothing"
} ""

STRING Trigger_Steered_Parameter_Value[10] "parameter value to be changed to"
{
  ".+" :: "parameter value"
  "^$" :: "can be empty"
} ""

CCTK_INT Trigger_Debug "turnes on debug messages"
{
   0:1 :: "Only 0 (off, default) or 1 (on)"
} 0

